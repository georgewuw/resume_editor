# --- 默认规则：Git 自动判别文本 / 二进制，文本统一 LF ---
* text=auto eol=lf

# --- 显式声明文本类型，规避自动判别的边界情况 ---
*.go            text eol=lf
*.mod           text eol=lf
*.sum           text eol=lf
*.js            text eol=lf
*.mjs           text eol=lf
*.sh            text eol=lf
*.ts            text eol=lf
*.css           text eol=lf
*.html          text eol=lf
*.json          text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf
*.md            text eol=lf
*.svg           text eol=lf
*.txt           text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

# --- 二进制资源：禁止换行转换与文本 diff ---
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.pdf   binary
*.syso  binary
*.exe   binary
*.dll   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.zip   binary

# --- 唯一例外：cmd.exe 批处理对 LF 解析不可靠，须保留 CRLF ---
*.bat   text eol=crlf
*.cmd   text eol=crlf
