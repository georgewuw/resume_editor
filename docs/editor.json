{
  "groups": [
    {
      "id": "personal",
      "title": "个人信息",
      "en": "Profile",
      "description": "姓名与三行信息按整页中心居中，证件照固定在内容区右上角。"
    },
    {
      "id": "advantage",
      "title": "个人优势",
      "en": "Self-Assessment",
      "description": "首行为不加粗的一句话简述，其余条目为「加粗要点 + 描述」。"
    },
    {
      "id": "work",
      "title": "工作经历",
      "en": "Work Experience",
      "description": "四列网格对齐：起止时间 / 公司 / 部门 / 职位。"
    },
    {
      "id": "project",
      "title": "项目经验",
      "en": "Project Experience",
      "description": "第 1~4 条落在第 1 页，第 5~6 条续在第 2 页，标题不重复。"
    },
    {
      "id": "education",
      "title": "教育背景",
      "en": "Education",
      "description": "三列网格对齐：起止时间 / 学校 / 专业学位。"
    },
    {
      "id": "certificate",
      "title": "资格证书",
      "en": "Professional Skills",
      "description": "每行一条，生成时自动渲染为独立行。"
    }
  ],
