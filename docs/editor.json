{
  "groups": [
    {
      "id": "personal",
      "title": "个人信息",
      "en": "Profile",
      "description": "姓名与三行信息按整页中心居中，证件照固定在内容区右上角。"
    },
    {
      "id": "advantage",
      "title": "个人优势",
      "en": "Self-Assessment",
      "description": "简述独立保留，优势条目以卡片编辑，可增加或删除，最多 6 项。"
    },
    {
      "id": "work",
      "title": "工作经历",
      "en": "Work Experience",
      "description": "工作经历以卡片编辑，可增加或删除，最多 5 段。"
    },
    {
      "id": "project",
      "title": "项目经验",
      "en": "Project Experience",
      "description": "项目经验以卡片编辑，可增加或删除，最多 6 个。"
    },
    {
      "id": "education",
      "title": "教育背景",
      "en": "Education",
      "description": "教育经历以卡片编辑，可增加或删除，最多 3 段。"
    },
    {
      "id": "certificate",
      "title": "资格证书",
      "en": "Professional Skills",
      "description": "每行一条，生成时自动渲染为独立行。"
    }
  ],
